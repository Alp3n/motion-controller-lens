{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serwer (symulacja)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/server",
      "python": "${workspaceFolder}/server/.venv/bin/python",
      "env": {
        "PROGRAMS_DIR": "${workspaceFolder}/programs",
        "AXES_CONFIG": "${workspaceFolder}/config/axes.json"
      },
      "jinja": true
    },
    {
      "name": "Testy (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/server",
      "python": "${workspaceFolder}/server/.venv/bin/python",
      "env": {
        "PROGRAMS_DIR": "${workspaceFolder}/programs",
        "AXES_CONFIG": "${workspaceFolder}/config/axes.json"
      }
    }
  ]
}
