{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Środowisko: utwórz venv i zainstaluj zależności",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -q --upgrade pip && .venv/bin/pip install -q -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": []
    },
    {
      "label": "Serwer: uruchom (symulacja)",
      "type": "shell",
      "command": "${workspaceFolder}/server/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "PROGRAMS_DIR": "${workspaceFolder}/programs",
          "AXES_CONFIG": "${workspaceFolder}/config/axes.json"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Testy: pytest",
      "type": "shell",
      "command": "${workspaceFolder}/server/.venv/bin/python -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "PROGRAMS_DIR": "${workspaceFolder}/programs",
          "AXES_CONFIG": "${workspaceFolder}/config/axes.json"
        }
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
