# Konfiguracja mostka SC4-Hub.
# Użycie:  set -a; . ./machine.env; set +a; ./sc4hub_bridge

# --- mapowanie osi -------------------------------------------------------
# Ustalone 2026-08-14 trybem --identify. Wiązanie po numerze seryjnym, a nie
# po pozycji w pierścieniu — przełożenie wtyków nie przestawi osi.
#
#   Node[0] S/N 90404362 -> Z (oś frezu)
#   Node[1] S/N 90406231 -> X (pozioma)
#   Node[2] S/N 90406002 -> Y (pionowa)

AXIS_X_SERIAL=90406231
AXIS_Y_SERIAL=90406002
AXIS_Z_SERIAL=90404362

# --- jednostki -----------------------------------------------------------
# Serwo liczy w impulsach enkodera; mm bierze się dopiero z przełożenia.
# Rozdzielczość (imp/obr) mostek ODCZYTUJE z serwa — nie ustawiaj jej tutaj,
# chyba że świadomie chcesz nadpisać odczyt (COUNTS_PER_REV).
#
# MM_PER_REV = skok śruby kulowej. Wartość startowa dla wszystkich osi —
# właściwe przełożenia (osobno na oś) przysyła serwer komendą AXCFG
# z ekranu „Konfiguracja osi". Stąd bierze się tylko to, z czym mostek
# wystartuje, zanim serwer się połączy.

MM_PER_REV=5.0

# --- limity --------------------------------------------------------------
# Ostrożne wartości na próby z czystymi serwami.

MAX_RPM=400
ACC_RPM_PER_SEC=1000

# --- wrzeciono -----------------------------------------------------------
# none: nic nie jest podłączone, mostek tylko śledzi stan.
# brake0/brake1: wyjście huba (24 V) sterujące przekaźnikiem.

SPINDLE_OUTPUT=none
